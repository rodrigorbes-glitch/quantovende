# 1. SUPABASE (Frontend - Variáveis Públicas)
VITE_SUPABASE_URL=https://sua-url-aqui.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui

# 2. SUPABASE (Server-side/Edge Functions - PRIVADO)
# NUNCA exponha esta chave no código frontend
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-privada-aqui

# 3. CRON E WORKERS (Server-side - PRIVADO)
# NUNCA exponha esta chave no frontend
# CRON_SECRET=seu-segredo-de-cron-aqui

# 4. APIs DE MARKETPLACES (Server-side - PRIVADO)
# NUNCA exponha tokens da Amazon ou ML no frontend
# AMAZON_SP_API_CLIENT_ID=
# AMAZON_SP_API_CLIENT_SECRET=
# MERCADO_LIVRE_CLIENT_ID=
# MERCADO_LIVRE_CLIENT_SECRET=
